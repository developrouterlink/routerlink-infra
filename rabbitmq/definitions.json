{
  "rabbit_version": "3.13.0",
  "users": [
    {
      "name": "router_admin",
      "password": "router_pass",
      "tags": ["administrator"]
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "router_admin",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "adm.events.exchange",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "fiscal.events.exchange",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "adm.email.default",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "fiscal.email.default",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "fiscal.nfe.processamento",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "adm.events.exchange",
      "vhost": "/",
      "destination": "adm.email.default",
      "destination_type": "queue",
      "routing_key": "adm.email.default",
      "arguments": {}
    },
    {
      "source": "fiscal.events.exchange",
      "vhost": "/",
      "destination": "fiscal.email.default",
      "destination_type": "queue",
      "routing_key": "fiscal.email.default",
      "arguments": {}
    }
  ]
}
