# ==============================================================================
# INFRAESTRUTURA GERAL (Docker Compose & Redes)
# ==============================================================================
COMPOSE_PROJECT_NAME=routerlink

# ==============================================================================
# BANCO DE DADOS: MySQL 8.0 (ERP, ADM & Fiscal)
# ==============================================================================
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root_secure_password
MYSQL_DATABASE=adm_db
MYSQL_USER=router_user
MYSQL_PASSWORD=router_pass

# URLs prontas para conectar via IDE / DBeaver / IntelliJ:
#   ERP:    jdbc:mysql://localhost:3306/erp_db?user=router_user&password=router_pass
#   ADM:    jdbc:mysql://localhost:3306/adm_db?user=router_user&password=router_pass
#   FISCAL: jdbc:mysql://localhost:3306/fiscal_db?user=router_user&password=router_pass


# ==============================================================================
# MENSAGERIA: RabbitMQ 3 Management
# ==============================================================================
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_DEFAULT_USER=router_admin
RABBITMQ_DEFAULT_PASS=router_pass

# URL pronta: amqp://router_admin:router_pass@localhost:5672
# Dashboard:  http://localhost:15672 (user: router_admin / pass: router_pass)

# ==============================================================================
# MICROSERVIÇOS (Portas & Segredos)
# ==============================================================================
REGISTRY_PORT=8081
ERP_PORT=8080
GATEWAY_PORT=8082
ADM_PORT=8083
FISCAL_PORT=8085
NOTIFICACOES_PORT=8084

# Segredos JWT e Criptografia
JWT_SECRET=dev-secret-jwt-key-987654321012345678901234567890
JASYPT_MASTER_PASSWORD=masterpass_development_secret

# AWS S3 / Storage (Mock ou Localstack / AWS Dev)
AWS_ACCESS_KEY=local_access_key
AWS_SECRET_KEY=local_secret_key
AWS_REGION=us-east-1
S3_BUCKET_EMPRESAS=routerlink-empresas-dev
S3_BUCKET_CONTRATOS=routerlink-contratos-dev
S3_BUCKET_DOCUMENTOS_FISCAIS=routerlink-documentos-fiscais-dev

# Configurações de E-mail (Serviço de Notificações)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORTA=2525
EMAIL_USUARIO=mailtrap_user
EMAIL_SENHA=mailtrap_password

# ==============================================================================
# FRONTEND & MÓDULOS WEB
# ==============================================================================
FRONTEND_PORT=3000
SEFAZ_CLIENTE_PORT=3001
SEFAZ_BACKOFFICE_PORT=3002
SEFAZ_MOCK_PORT=8090
